{
  "ConnectionStrings": { //this use port internaly of postgres container, the 5400 port is for outside network to connect
    "Database": "Host=evently.database;Port=5432;Database=evently;Username=postgres;Password=postgres;Include Error Detail=true",
    "CachingService": "evently.redis:6379"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Seq",
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://evently.seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Evently.Api"
    }
  },
  "Authentication": {
    "Audience": "account",
    "TokenValidationParameters": {
      // to explain why we need 2 valid issuer for keycloak
      // the 1st URL: welp, this is reqiured obviously since the docket network resolve the name and internal port
      // the 2nd URL: we NEED THIS, since we can call the keycloak directly to get access token, which we get from localhost on machine
      //so we need it so that it is still a valid issuer 
      // => 1st for internal docker , 2nd for from localhost (local machine)
      "ValidIssuers": [ "http://evently.identity:8080/realms/Evently", "http://localhost:18080/realms/Evently" ]
    },
    "MetadataAddress": "http://evently.identity:8080/realms/Evently/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "KeyCloak": {
    "HealthUrl": "http://evently.identity:8080/health/"
  }
}
